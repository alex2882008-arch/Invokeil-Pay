    <!-- Onboarding — step 3: permissions -->
    <string name="ob_perm_title">Permissions needed</string>
    <string name="ob_perm_body">Grant these to let the app listen for payment SMS in the background.</string>
    <string name="perm_sms_title">SMS read &amp; receive</string>
    <string name="perm_sms_body">Required to capture incoming payment SMS. The app forwards only whitelisted sender messages — never OTPs — and logs everything locally.</string>
    <string name="perm_notif_title">Notifications</string>
    <string name="perm_notif_body">Shows a persistent "listening" status and forwarding results. You can turn event notifications off later in Settings.</string>
    <string name="perm_battery_title">Battery optimization exemption</string>
    <string name="perm_battery_body">Exempts the app from Doze so SMS forwarding is instant, even when the phone sleeps. Without it, messages may be delayed.</string>

    <!-- Prominent disclosure (shown before the SMS permission prompt) -->
    <string name="disclosure_title">SMS data disclosure</string>
    <string name="disclosure_body">Invokeil Pay collects incoming SMS messages and forwards them to the panel you pair it with, for the sole purpose of verifying customer payments. SMS data is used only for payment verification: it is not sold, and it is not shared with any other third party. Messages containing OTP, PIN, or verification codes are filtered on your device and never uploaded. Only senders on your whitelist (e.g. bKash, NAGAD) are forwarded, and every forwarded message is recorded in the in-app SMS log. You can stop forwarding at any time by tapping Unpair in Settings.</string>
    <string name="disclosure_accept">I understand &amp; allow</string>
    <string name="disclosure_decline">Not now</string>

