    <!-- Onboarding — step 1: welcome -->
    <string name="ob_welcome_title">Welcome to Invokeil Pay</string>
    <string name="ob_welcome_body">The companion app that forwards your mobile-money payment SMS to your Invokeil Pay panel — automatically, securely, and in real time.</string>
    <string name="ob_welcome_bullet_1">• Only payment SMS from whitelisted senders are forwarded</string>
    <string name="ob_welcome_bullet_2">• OTP / PIN / verification codes never leave your phone</string>
    <string name="ob_welcome_bullet_3">• Every message is visible in the in-app SMS log</string>
    <string name="btn_get_started">Get started</string>
    <string name="lang_en">English</string>
    <string name="lang_bn">বাংলা</string>

    <!-- Onboarding — step 2: pair -->
    <string name="ob_pair_title">Pair with your panel</string>
    <string name="ob_pair_body">Scan the pairing QR code shown on your panel (Devices → Add device), or enter the details manually.</string>
    <string name="btn_scan_qr">Scan QR code</string>
    <string name="pairing_code">Pairing code (optional)</string>
