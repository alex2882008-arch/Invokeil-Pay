    <string name="ob_perm_body">ব্যাকগ্রাউন্ডে পেমেন্ট এসএমএস শুনতে এগুলো অনুমতি দিন।</string>
    <string name="perm_sms_title">এসএমএস পড়া ও গ্রহণ</string>
    <string name="perm_sms_body">আসা পেমেন্ট এসএমএস ধরতে এটি প্রয়োজন। শুধু অনুমোদিত প্রেরকের বার্তা ফরওয়ার্ড হয় — OTP কখনও নয় — এবং সবকিছু লোকাল লগে থাকে।</string>
    <string name="perm_notif_title">নোটিফিকেশন</string>
    <string name="perm_notif_body">চলমান "শুনছে" স্ট্যাটাস ও ফরওয়ার্ডিংয়ের ফলাফল দেখায়। পরে সেটিংস থেকে বন্ধ করা যাবে।</string>
    <string name="perm_battery_title">ব্যাটারি অপ্টিমাইজেশন থেকে অব্যাহতি</string>
    <string name="perm_battery_body">এটি দিলে ফোন ঘুমিয়ে থাকলেও এসএমএস তাৎক্ষণিক ফরওয়ার্ড হয়। না দিলে বার্তা দেরিতে যেতে পারে।</string>

    <!-- Prominent disclosure (shown before the SMS permission prompt) -->
    <string name="disclosure_title">এসএমএস তথ্য সংক্রান্ত প্রকাশনা</string>
    <string name="disclosure_body">Invokeil Pay আসা এসএমএস বার্তা সংগ্রহ করে এবং কেবল গ্রাহকের পেমেন্ট যাচাইয়ের উদ্দেশ্যে আপনার যুক্ত প্যানেলে পাঠায়। এসএমএস তথ্য শুধু পেমেন্ট যাচাইয়ের জন্য ব্যবহৃত হয়: বিক্রি করা হয় না, এবং অন্য কোনো তৃতীয় পক্ষের সাথে শেয়ার করা হয় না। OTP, পিন বা ভেরিফিকেশন কোডযুক্ত বার্তা আপনার ডিভাইসেই বাদ দেওয়া হয়, কখনও আপলোড হয় না। শুধু আপনার তালিকাভুক্ত প্রেরকের (যেমন bKash, NAGAD) বার্তা ফরওয়ার্ড হয় এবং প্রতিটি ফরওয়ার্ড হওয়া বার্তা অ্যাপের এসএমএস লগে সংরক্ষিত থাকে। সেটিংসে Unpair চাপলে যেকোনো সময় ফরওয়ার্ডিং বন্ধ করতে পারবেন।</string>
